# Trade Worker Environment Variables (local development)
# Copy to .dev.vars and replace with actual values from `hoox setup` output.
# .dev.vars is gitignored — never commit secrets.

# Internal auth key for service-to-service authentication
INTERNAL_KEY_BINDING=your_internal_key_binding_here

# Scoped keys (recommended): execute vs read separation
# TRADE_EXECUTE_KEY_BINDING=your_trade_execute_key_here
# TRADE_READ_KEY_BINDING=your_trade_read_key_here

# Telegram internal key for sending trade notifications
TELEGRAM_INTERNAL_KEY_BINDING=your_telegram_internal_key_here

# Unified exchange API credentials (one pair for Binance / Bybit / MEXC).
# Venue is selected by the signal payload / routing config — not by secret name.
EXCHANGE_KEY_BINDING=your_exchange_api_key_here
EXCHANGE_SECRET_BINDING=your_exchange_api_secret_here

# Optional dedicated testnet keys (preferred when webhook has "test": true)
# Falls back to EXCHANGE_* live bindings if unset.
# EXCHANGE_TESTNET_KEY_BINDING=your_exchange_testnet_api_key_here
# EXCHANGE_TESTNET_SECRET_BINDING=your_exchange_testnet_api_secret_here

# Legacy per-venue bindings still work as fallbacks if set (deprecated):
# BINANCE_KEY_BINDING=...
# BINANCE_SECRET_BINDING=...
# BYBIT_KEY_BINDING=...
# BYBIT_SECRET_BINDING=...
# MEXC_KEY_BINDING=...
# MEXC_SECRET_BINDING=...
